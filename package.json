{
  "name": "tars",
  "version": "0.0.0",
  "description": "TARS cockpit assistant for Elite Dangerous, built on the mature COVAS:NEXT runtime.",
  "homepage": "https://github.com/rex688-png/TARS#readme",
  "bugs": {
    "url": "https://github.com/rex688-png/TARS/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rex688-png/TARS.git"
  },
  "license": "ISC",
  "author": "TARS contributors; based on COVAS:NEXT by RatherRude",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "install:all": "npm run install:py && npm run install:electron && npm run install:ui",
    "install:py": "pip install -r requirements.txt",
    "install:electron": "npm install",
    "install:ui": "cd ui && npm install",
    "start": "cross-env NODE_ENV=development concurrently --kill-others \"cd ui && npx ng serve\" \"cd electron && wait-on http://localhost:1420/ && npx electron ./index.js\"",
    "build": "npm run build:ui && npm run build:py",
    "build:ui": "cd ui && npx ng build --configuration production",
    "build:py": "run-script-os",
    "build:py:win32": "powershell ./e2e/build.ps1",
    "package": "run-script-os",
    "package:win32": "npm run package:dir && npm run package:msi",
    "package:dir": "electron-builder --dir",
    "package:msi": "electron-builder --win msi",
    "package:run": "run-script-os",
    "package:run:win32": "cd dist/win-unpacked/ && start TARS.exe",
    "test:overlay": "node --test test/electron/desktop-overlay-lifecycle.test.js",
    "test:frontend-foundation": "node --test test/frontend/run-tests.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "electron": "^38.8.6",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "productName": "TARS",
    "appId": "com.rex688.tars",
    "executableName": "TARS",
    "directories": {
      "buildResources": "electron"
    },
    "win": {
      "icon": "electron/icon.ico"
    },
    "extraResources": [
      {
        "from": "dist/Chat",
        "to": "Chat"
      },
      {
        "from": "vendor/tars-plugins",
        "to": "tars-plugins",
        "filter": ["**/*", "!**/__pycache__/**", "!**/*.pyc"]
      }
    ],
    "files": [
      {
        "from": "electron",
        "to": "."
      },
      {
        "from": "ui/dist/covas-next-ui/browser",
        "to": "ui"
      }
    ]
  },
  "dependencies": {
    "@covas-labs/electron-overlay": "^0.5.2",
    "@covas-labs/electron-vr": "^0.8.1",
    "cross-env": "^7.0.3",
    "electron-context-menu": "^4.1.0",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "pino-roll": "^3.1.0",
    "run-script-os": "^1.1.6",
    "wait-on": "^8.0.4",
    "ws": "^8.21.0"
  }
}
